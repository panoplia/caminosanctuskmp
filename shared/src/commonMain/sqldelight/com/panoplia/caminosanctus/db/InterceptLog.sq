CREATE TABLE intercept_log (
    id              TEXT    NOT NULL PRIMARY KEY,
    timestamp       INTEGER NOT NULL,
    target_app      TEXT    NOT NULL,
    duration_ms     INTEGER,
    completed       INTEGER NOT NULL DEFAULT 0,
    skipped         INTEGER NOT NULL DEFAULT 0,
    bypass_reason   TEXT,
    content_card_id TEXT,
    phase           TEXT    NOT NULL,
    created_at      INTEGER NOT NULL
);

CREATE INDEX idx_il_target_ts ON intercept_log(target_app, timestamp);
CREATE INDEX idx_il_completed  ON intercept_log(completed);

insertLog:
INSERT INTO intercept_log (
    id, timestamp, target_app, duration_ms,
    completed, skipped, bypass_reason, content_card_id, phase, created_at
) VALUES (
    :id, :timestamp, :targetApp, :durationMs,
    :completed, :skipped, :bypassReason, :contentCardId, :phase, :createdAt
);

getBypassCountInWindow:
SELECT COUNT(*) FROM intercept_log
WHERE target_app = :targetApp
  AND timestamp  > :windowStartMs
  AND completed  = 0
  AND bypass_reason IS NULL;

getCompletedSince:
SELECT timestamp FROM intercept_log
WHERE timestamp > :since AND completed = 1
ORDER BY timestamp ASC;

getTotalCompleted:
SELECT COUNT(*) FROM intercept_log WHERE completed = 1;

logEmergencyBypass:
INSERT INTO intercept_log (
    id, timestamp, target_app, duration_ms,
    completed, skipped, bypass_reason, content_card_id, phase, created_at
) VALUES (
    :id, :timestamp, :targetApp, NULL,
    0, 0, 'EMERGENCY', NULL, 'PROFUNDIDAD', :createdAt
);
